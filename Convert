# -*- coding: utf-8 -*-

import dataiku
import pandas as pd
import io
import numbers


# ============================================================
# 1. LECTURE DU MANAGED FOLDER ORIGINAL
# ============================================================

api_logs_archive = dataiku.Folder("8rkelVGG")

files = api_logs_archive.list_paths_in_partition()

parquet_files = [f for f in files if f.endswith(".parquet")]

if len(parquet_files) != 1:
    raise Exception(
        f"Nombre de fichiers Parquet inattendu dans api_logs_archive : "
        f"{len(parquet_files)}"
    )

parquet_file = parquet_files[0]

print(f"Fichier lu : {parquet_file}")


# ============================================================
# 2. LECTURE DU PARQUET
# ============================================================

with api_logs_archive.get_download_stream(parquet_file) as stream:
    parquet_bytes = stream.read()

df = pd.read_parquet(io.BytesIO(parquet_bytes))

print(f"Nombre de lignes : {len(df)}")
print(f"Type timestamp avant correction : {df['timestamp'].dtype}")


# ============================================================
# 3. CONVERSION DE TOUS LES TIMESTAMPS
# ============================================================

def convert_timestamp(value):

    if pd.isna(value):
        return pd.NaT

    # Cas 1 : timestamp numérique en nanosecondes
    # Exemple :
    # 1787054485336196000
    # 1696516200000000000
    if isinstance(value, numbers.Number):
        return pd.to_datetime(
            value,
            unit="ns",
            errors="raise"
        )

    # Cas 2 : timestamp sous forme de texte
    # Exemple :
    # 2026-01-30T10:19:49.092335
    # ou
    # 2023-10-05 14:32:00
    return pd.to_datetime(
        value,
        errors="raise"
    )


df["timestamp"] = df["timestamp"].apply(convert_timestamp)


# ============================================================
# 4. VERIFICATIONS
# ============================================================

print("\nType timestamp après correction :")
print(df["timestamp"].dtype)

print("\nPremiers timestamps après correction :")
print(df["timestamp"].head(20))

print("\nNombre de timestamps NULL :")
print(df["timestamp"].isna().sum())


# ============================================================
# 5. ECRITURE DANS LE DATASET TEMPORAIRE
# ============================================================

api_logs_archive_test = dataiku.Dataset("api_logs_archive_test")

api_logs_archive_test.write_with_schema(df)

print("\n==========================================")
print("CORRECTION TERMINEE")
print("Output : api_logs_archive_test")
print("==========================================")
