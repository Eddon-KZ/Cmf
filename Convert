import dataiku
import pandas as pd
import io
import numbers


# ============================================================
# 1. LECTURE DU FICHIER ORIGINAL
# ============================================================

ARCHIVE_FOLDER = dataiku.Folder("api_logs_archive")

files = ARCHIVE_FOLDER.list_paths_in_partition()

parquet_files = [f for f in files if f.endswith(".parquet")]

if len(parquet_files) != 1:
    raise Exception(
        f"Nombre de fichiers Parquet inattendu : {len(parquet_files)}"
    )

parquet_file = parquet_files[0]

print(f"Fichier lu : {parquet_file}")

with ARCHIVE_FOLDER.get_download_stream(parquet_file) as stream:
    df = pd.read_parquet(io.BytesIO(stream.read()))

print(f"Nombre de lignes : {len(df)}")
print(f"Type timestamp avant correction : {df['timestamp'].dtype}")


# ============================================================
# 2. CONVERSION DE TOUS LES TIMESTAMPS
# ============================================================

def convert_timestamp(value):

    if pd.isna(value):
        return pd.NaT

    # Cas 1 : timestamp numérique en nanosecondes
    # Exemple : 1787054485336196000
    if isinstance(value, numbers.Number):
        return pd.to_datetime(value, unit="ns", errors="raise")

    # Cas 2 : timestamp texte
    # Exemple : 2026-01-30T10:19:49.092335
    return pd.to_datetime(value, errors="raise")


df["timestamp"] = df["timestamp"].apply(convert_timestamp)


# ============================================================
# 3. VERIFICATION
# ============================================================

print("\nType timestamp après correction :")
print(df["timestamp"].dtype)

print("\nQuelques timestamps après correction :")
print(df["timestamp"].head(20))

print("\nNombre de timestamps NULL :")
print(df["timestamp"].isna().sum())


# ============================================================
# 4. ECRITURE DANS LE DATASET TEMPORAIRE
# ============================================================

OUTPUT_DATASET = dataiku.Dataset("api_logs_archive_test")

OUTPUT_DATASET.write_with_schema(df)

print("\nCorrection terminée.")
print("Dataset corrigé : api_logs_archive_test")
