import dataiku
import pandas as pd
import io
import numbers
from datetime import datetime


# ============================================================
# 1. Managed Folder api_logs_archive
# ============================================================

folder = dataiku.Folder("8rkelVGG")


# ============================================================
# 2. Fichier source du vendredi
# ============================================================

source_file = "api_logs_archive_20261023_142059.parquet"

files = folder.list_paths_in_partition()

if source_file not in files:
    raise Exception(
        f"Fichier source introuvable : {source_file}\n"
        f"Fichiers disponibles : {files}"
    )


# ============================================================
# 3. Lecture du fichier Parquet
# ============================================================

with folder.get_download_stream(source_file) as stream:
    df = pd.read_parquet(io.BytesIO(stream.read()))


original_row_count = len(df)

print(f"Fichier source : {source_file}")
print(f"Nombre de lignes avant correction : {original_row_count}")


# ============================================================
# 4. Correction de la colonne timestamp
# ============================================================

def convert_timestamp(value):

    if pd.isna(value):
        return None

    # Cas actuel : timestamp stocké en nanosecondes
    if isinstance(value, numbers.Number):
        dt = pd.to_datetime(
            value,
            unit="ns",
            errors="raise"
        )

    # Sécurité si certaines valeurs sont déjà sous forme de date
    else:
        dt = pd.to_datetime(
            value,
            errors="raise"
        )

    # IMPORTANT :
    # on retourne une STRING, sans timezone et sans "Z",
    # exactement comme dans R&D Design / la source PostgreSQL.
    return dt.strftime("%Y-%m-%dT%H:%M:%S.%f")


df["timestamp"] = (
    df["timestamp"]
    .apply(convert_timestamp)
    .astype("string")
)


# ============================================================
# 5. Vérifications avant écriture
# ============================================================

if len(df) != original_row_count:
    raise Exception(
        f"ERREUR : le nombre de lignes a changé ! "
        f"Avant={original_row_count}, Après={len(df)}"
    )

if df["timestamp"].isna().any():
    raise Exception(
        "ERREUR : des timestamps sont devenus NULL."
    )

print(f"Nombre de lignes après correction : {len(df)}")
print(f"Type timestamp : {df['timestamp'].dtype}")

print("\nExemples de timestamps corrigés :")
print(df["timestamp"].head(10))


# ============================================================
# 6. Création du nouveau fichier avec la date/heure du jour
# ============================================================

new_file = (
    f"api_logs_archive_"
    f"{datetime.now().strftime('%Y%m%d_%H%M%S')}.parquet"
)


# ============================================================
# 7. Création du Parquet en mémoire
# ============================================================

output = io.BytesIO()

df.to_parquet(
    output,
    index=False,
    engine="pyarrow"
)

output.seek(0)


# ============================================================
# 8. Écriture du nouveau fichier dans LE MÊME Managed Folder
# ============================================================

folder.upload_stream(
    new_file,
    output
)


# ============================================================
# 9. Résultat
# ============================================================

print("\n========================================")
print("CORRECTION TERMINEE")
print("========================================")
print(f"Ancien fichier : {source_file}")
print(f"Nouveau fichier : {new_file}")
print(f"Nombre de lignes : {len(df)}")
print("Timestamp converti en STRING")
print("Aucune timezone / aucun Z ajouté")
print("Ancien fichier conservé")
print("========================================")
