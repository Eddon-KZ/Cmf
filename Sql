SELECT
    '${archive_cutoff_date}'::timestamp AS archive_cutoff_date,
    COUNT(*) AS rows_to_delete,
    MIN(CAST("timestamp" AS timestamp)) AS first_deleted,
    MAX(CAST("timestamp" AS timestamp)) AS last_deleted
FROM ave_api_logs
WHERE "timestamp" <> 'Timestamp'
  AND CAST("timestamp" AS timestamp) < '${archive_cutoff_date}'::timestamp;

